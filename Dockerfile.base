FROM python:3.14-slim
ENV WEEWX_ROOT=/home/weewx/weewx-data
ENV HOME=/home/weewx
ENV TZ=America/New_York
ENV PATH=/usr/bin:$PATH
ENV LANG=en_US.UTF-8

ARG BUILD_DEPS="wget unzip git libffi-dev libjpeg-dev gcc g++ build-essential zlib1g-dev"

RUN apt-get update \
  && apt-get install --no-install-recommends -y \
      $BUILD_DEPS \
      tzdata \
      sudo \
      rsync \
      vim \
      openssh-client \
      openssl \
      locales \
  && rm -rf /var/lib/apt/lists/* \
  && echo "en_US.UTF-8 UTF-8" > /etc/locale.gen \
  && echo "en_GB.UTF-8 UTF-8" >> /etc/locale.gen \
  && echo "de_DE.UTF-8 UTF-8" >> /etc/locale.gen \
  && echo "nl_NL.UTF-8 UTF-8" >> /etc/locale.gen \
  && locale-gen \
  && addgroup weewx \
  && useradd -m -g weewx weewx \
  && echo "weewx ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/weewx \
  && chmod 0440 /etc/sudoers.d/weewx \
  && chown -R weewx:weewx /home/weewx \
  && chmod -R 755 /home/weewx

USER weewx

RUN python3 -m venv /home/weewx/weewx-venv \
  && chmod -R 755 /home/weewx

# Deliberately unpinned. build-base.sh builds with the layer cache, and
# Docker keys that cache on this RUN's text plus the parent layer — never on
# what pip resolves. So an unchanged line here is a cache hit, pip does not
# run, and the layer digest stays stable, which is what keeps a later publish
# from re-uploading the whole base.
# The flip side: these versions do not move on their own. To pick up new
# ones, force this layer to rebuild — `./build-base.sh` with --no-cache
# added, or edit this line. Expect a full re-upload when you do; that upload
# is real new content, not churn.
RUN . /home/weewx/weewx-venv/bin/activate \
  && python3 -m pip install --no-cache-dir \
      numpy \
      pandas \
      skyfield \
      paho-mqtt \
      db-sqlite3 \
      requests

RUN . /home/weewx/weewx-venv/bin/activate \
  && pip install weewx==5.5.0 \
  && weectl station create --no-prompt

USER root
RUN apt-get purge -y $BUILD_DEPS \
  && apt-get autoremove -y \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*
USER weewx
